# /etc/xairos/xairos.env: read by PocketBase, the worker and the backups.
# install.sh fills in the host, time zone, keys and secrets. Mode 0640 root:xairos.
# Never commit the real file.

# The name devices use to reach this server; xairos is served at https://XAIROS_HOST.
XAIROS_HOST=xairos.example.com
XAIROS_PUBLIC_URL=https://xairos.example.com
# HTTPS: "internal" (Caddy's own CA, private network) or an email for Let's Encrypt.
# install.sh sets it from --tls; after a change, rerun install.sh to update caddy.env.
# The server's local date anchors "tomorrow" for quick adds that do not send a date.
TZ=UTC

# PocketBase for the worker.
XAIROS_PB_URL=http://127.0.0.1:8090
XAIROS_NOTIFIER_STATE=/var/lib/xairos/notifier/state.json

# Web Push and the worker's shared secret (made by install.sh; never regenerate the VAPID
# keys on a live server: every device would have to turn background reminders on again).
# XAIROS_VAPID_PUBLIC=
# XAIROS_VAPID_PRIVATE=
# XAIROS_VAPID_SUBJECT=mailto:you@example.com
# XAIROS_NOTIFIER_SECRET=

# Google Calendar (optional, see README "Google Calendar").
# XAIROS_GOOGLE_CLIENT_ID=
# XAIROS_GOOGLE_CLIENT_SECRET=
# XAIROS_GOOGLE_REDIRECT=http://127.0.0.1:1/

# Backups: space-separated restic repositories. The first is local (fast restores, and the
# laptop pulls from it); add the off-site one, e.g. sftp:u123@u123.your-storagebox.de:xairos
# or b2:bucket:xairos (then set B2_ACCOUNT_ID and B2_ACCOUNT_KEY below).
XAIROS_RESTIC_REPOS="/var/lib/xairos/restic"
RESTIC_PASSWORD_FILE=/etc/xairos/restic-password
